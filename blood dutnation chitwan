<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blood Donation - Bharatpur Hospital</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #e74c3c 0%, #e44331 100%);
            min-height: 100vh;
            color: #302e2e;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        /* Header */
        .header {
            background: rgba(255, 255, 255, 0.98);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            margin-bottom: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.8em;
            color: #c0392b;
            margin-bottom: 10px;
        }

        .header .hospital-name {
            font-size: 1.3em;
            color: #e74c3c;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .header p {
            color: #666;
            font-size: 1.1em;
            margin-bottom: 20px;
        }

        .header-contact {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
            margin-top: 15px;
            padding-top: 15px;
            border-top: 2px solid #eee;
        }

        .contact-info {
            font-size: 0.95em;
            color: #555;
        }

        .contact-info strong {
            color: #c0392b;
        }

        /* Navigation */
        .nav {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .nav button {
            background: #e74c3c;
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 25px;
            cursor: pointer;
            font-size: 0.95em;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .nav button:hover {
            background: #c0392b;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(192, 57, 43, 0.4);
        }

        /* Main Grid */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 25px;
            margin-bottom: 30px;
        }

        /* Cards */
        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            transition: all 0.3s ease;
            border-left: 5px solid #e74c3c;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
        }

        .card-icon {
            width: 100%;
            height: 150px;
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 4em;
        }

        .card-content {
            padding: 25px;
        }

        .card-title {
            font-size: 1.6em;
            color: #c0392b;
            margin-bottom: 12px;
            font-weight: bold;
        }

        .card-description {
            color: #666;
            line-height: 1.7;
            margin-bottom: 15px;
        }

        .card-stats {
            display: flex;
            justify-content: space-around;
            padding-top: 15px;
            border-top: 1px solid #eee;
        }

        .stat {
            text-align: center;
        }

        .stat-value {
            font-size: 1.8em;
            font-weight: bold;
            color: #e74c3c;
        }

        .stat-label {
            font-size: 0.85em;
            color: #999;
            margin-top: 5px;
        }

        /* Blood Type Section */
        .blood-types {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            margin-bottom: 30px;
        }

        .blood-types h2 {
            color: #c0392b;
            margin-bottom: 25px;
            font-size: 1.8em;
        }

        .blood-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 20px;
        }

        .blood-type {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 12px rgba(192, 57, 43, 0.2);
        }

        .blood-type:hover {
            transform: scale(1.1);
            box-shadow: 0 8px 20px rgba(192, 57, 43, 0.4);
        }

        .blood-type-name {
            font-size: 2.2em;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .blood-type-donors {
            font-size: 0.9em;
            opacity: 0.9;
        }

        /* Donation Form */
        .donation-form {
            background: white;
            border-radius: 15px;
            padding: 35px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            margin-bottom: 30px;
        }

        .donation-form h2 {
            color: #c0392b;
            margin-bottom: 25px;
            font-size: 1.8em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: #333;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1em;
            font-family: inherit;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #e74c3c;
            box-shadow: 0 0 8px rgba(231, 76, 60, 0.2);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .submit-btn {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
            border: none;
            padding: 15px 40px;
            border-radius: 8px;
            font-size: 1.1em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            width: 100%;
            margin-top: 10px;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(192, 57, 43, 0.3);
        }

        /* Hospital Locations */
        .locations {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            margin-bottom: 30px;
        }

        .locations h2 {
            color: #c0392b;
            margin-bottom: 25px;
            font-size: 1.8em;
        }

        .location-item {
            padding: 20px;
            border-left: 5px solid #e74c3c;
            margin-bottom: 20px;
            background: #f9f9f9;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .location-item:hover {
            background: #fff5f5;
            padding-left: 25px;
        }

        .location-hospital {
            font-size: 1.3em;
            font-weight: bold;
            color: #c0392b;
            margin-bottom: 10px;
        }

        .location-address {
            color: #666;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .location-phone {
            color: #e74c3c;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Benefits */
        .benefits {
            background: white;
            border-radius: 15px;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
            margin-bottom: 30px;
        }

        .benefits h2 {
            color: #c0392b;
            margin-bottom: 25px;
            font-size: 1.8em;
        }

        .benefits-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
        }

        .benefit-item {
            padding: 20px;
            background: #f9f9f9;
            border-radius: 10px;
            border-top: 4px solid #e74c3c;
        }

        .benefit-icon {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .benefit-title {
            font-size: 1.1em;
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
        }

        .benefit-text {
            color: #666;
            font-size: 0.95em;
            line-height: 1.6;
        }

        /* Footer */
        .footer {
            background: rgba(0, 0, 0, 0.8);
            color: white;
            text-align: center;
            padding: 30px;
            border-radius: 15px;
            margin-top: 40px;
        }

        .footer h3 {
            margin-bottom: 15px;
            color: #e74c3c;
        }

        .footer p {
            margin: 8px 0;
            opacity: 0.9;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 15px;
            flex-wrap: wrap;
        }

        .footer-links a {
            color: #e74c3c;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .footer-links a:hover {
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .header h1 {
                font-size: 2em;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .grid {
                grid-template-columns: 1fr;
            }

            .nav {
                flex-direction: column;
            }

            .nav button {
                width: 100%;
            }

            .header-contact {
                flex-direction: column;
                gap: 15px;
            }

            .blood-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <div class="hospital-name">🏥 Bharatpur  Government Hospital & Redcross +</div>
            <h1>🩸 Blood Donation stranger</h1>
            <p>Save Lives - Donate Blood Today</p>
            <div class="header-contact">
                <div class="contact-info">
                    <strong>📍 Location:</strong> Nepal bharatpur-10 chitwan
                </div>
                <div class="contact-info">
                    <strong>📞 Phone:</strong> +977 9701349064
                </div>
                <div class="contact-info">
                    <strong>⏰ Hours:</strong> 9:00 AM - 1:00 PM (Mon-Sat)
                </div>
            </div>
            <div class="nav">
                <button onclick="scrollToSection('donate')">Donate Now</button>
                <body>
                    <form action="<----CLECK" method="post"></form>
                </body>
                <button onclick="scrollToSection('blood-inventory')">Blood Inventory</button>
                <button onclick="scrollToSection('locations')">Locations</button>
                <button onclick="scrollToSection('eligibility')">Eligibility</button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid">
            <div class="card">
                <div class="card-icon">💉</div>
                <div class="card-content">
                    <div class="card-title">Total Donors</div>
                    <div class="card-description">
                        Join thousands of generous donors who have saved countless lives through blood donation.
                    </div>
                    <div class="card-stats">
                        <div class="stat">
                            <div class="stat-value">5,420</div>
                            <div class="stat-label">Registered</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">12,850</div>
                            <div class="stat-label">Units Donated</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-icon">❤️</div>
                <div class="card-content">
                    <div class="card-title">Lives Saved</div>
                    <div class="card-description">
                        Every donation can save up to 3 lives. Your contribution makes a real difference.
                    </div>
                    <div class="card-stats">
                        <div class="stat">
                            <div class="stat-value">38,550</div>
                            <div class="stat-label">Lives Saved</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">15</div>
                            <div class="stat-label">Years Active</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-icon">🎯</div>
                <div class="card-content">
                    <div class="card-title">Monthly Goal</div>
                    <div class="card-description">
                        Help us meet our monthly donation targets to ensure adequate blood supply.
                    </div>
                    <div class="card-stats">
                        <div class="stat">
                            <div class="stat-value">2,400</div>
                            <div class="stat-label">Target Units</div>
                        </div>
                        <div class="stat">
                            <div class="stat-value">67%</div>
                            <div class="stat-label">Achieved</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Blood Type Inventory -->
        <div class="blood-types" id="blood-inventory">
            <h2>🩸 Current Blood Inventory</h2>
            <div class="blood-grid">
                <div class="blood-type" onclick="alert('O+ Blood: 450 units available')">
                    <div class="blood-type-name">O+</div>
                    <div class="blood-type-donors">450 Units</div>
                </div>
                <div class="blood-type" onclick="alert('O- Blood: 280 units available')">
                    <div class="blood-type-name">O-</div>
                    <div class="blood-type-donors">280 Units</div>
                </div>
                <div class="blood-type" onclick="alert('A+ Blood: 320 units available')">
                    <div class="blood-type-name">A+</div>
                    <div class="blood-type-donors">320 Units</div>
                </div>
                <div class="blood-type" onclick="alert('A- Blood: 150 units available')">
                    <div class="blood-type-name">A-</div>
                    <div class="blood-type-donors">150 Units</div>
                </div>
                <div class="blood-type" onclick="alert('B+ Blood: 390 units available')">
                    <div class="blood-type-name">B+</div>
                    <div class="blood-type-donors">390 Units</div>
                </div>
                <div class="blood-type" onclick="alert('B- Blood: 175 units available')">
                    <div class="blood-type-name">B-</div>
                    <div class="blood-type-donors">175 Units</div>
                </div>
                <div class="blood-type" onclick="alert('AB+ Blood: 210 units available')">
                    <div class="blood-type-name">AB+</div>
                    <div class="blood-type-donors">210 Units</div>
                </div>
                <div class="blood-type" onclick="alert('AB- Blood: 95 units available')">
                    <div class="blood-type-name">AB-</div>
                    <div class="blood-type-donors">95 Units</div>
                </div>
            </div>
        </div>

        <!-- Donation Form -->
        <div class="donation-form" id="donate">
            <h2>📝 Blood Donation Registration</h2>
            <form onsubmit="submitDonation(event)">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full Name *</label>
                        <input type="text" id="name" name="name" required placeholder="Enter your full name">
                    </div>
                    <div class="form-group">
                        <label for="age">Age *</label>
                        <input type="number" id="age" name="age" min="18" max="65" required placeholder="18-65 years">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="phone">Phone Number *</label>
                        <input type="tel" id="phone" name="phone" required placeholder="10 digit mobile number">
                    </div>
                    <div class="form-group">
                        <label for="blood-type">Blood Type *</label>
                        <select id="blood-type" name="blood-type" required>
                            <option value="">Select Blood Type</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="weight">Weight (kg) *</label>
                        <input type="number" id="weight" name="weight" min="50" required placeholder="Minimum 50 kg">
                    </div>
                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" required placeholder="your@email.com">
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="date">Preferred Donation Date *</label>
                        <input type="date" id="date" name="date" required>
                    </div>
                    <div class="form-group">
                        <label for="time">Preferred Time *</label>
                        <select id="time" name="time" required>
                            <option value="">Select Time Slot</option>
                            <option value="09:00-10:00">9:00 AM - 10:00 AM</option>
                            <option value="10:00-11:00">10:00 AM - 11:00 AM</option>
                            <option value="11:00-12:00">11:00 AM - 12:00 PM</option>
                            <option value="02:00-03:00">2:00 PM - 3:00 PM</option>
                            <option value="03:00-04:00">3:00 PM - 4:00 PM</option>
                            <option value="04:00-05:00">4:00 PM - 5:00 PM</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="message">Medical History / Additional Info</label>
                    <textarea id="message" name="message" rows="4" placeholder="Any medical conditions or allergies? (Optional)"></textarea>
                </div>

                <div class="form-group">
                    <input type="checkbox" id="agree" name="agree" required>
                    <label for="agree" style="display: inline; margin-left: 8px;">I agree to the terms and conditions of blood donation</label>
                </div>

                <button type="submit" class="submit-btn">✅ Register for Donation</button>
            </form>
        </div>

        <!-- Eligibility -->
        <div class="benefits" id="eligibility">
            <h2>✅ Eligibility Requirements</h2>
            <div class="benefits-grid">
                <div class="benefit-item">
                    <div class="benefit-icon">👤</div>
                    <div class="benefit-title">Age & Weight</div>
                    <div class="benefit-text">
                        Must be 18-65 years old and weigh at least 50 kg (110 lbs).
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">❤️</div>
                    <div class="benefit-title">Health Status</div>
                    <div class="benefit-text">
                        Good general health with no fever, cold, or recent illness.
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">💊</div>
                    <div class="benefit-title">Medications</div>
                    <div class="benefit-text">
                        Not on antibiotics or blood thinners. Consult doctor if on other medications.
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">🥗</div>
                    <div class="benefit-title">Nutrition</div>
                    <div class="benefit-text">
                        Have eaten a healthy meal within 2 hours before donation.
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">💧</div>
                    <div class="benefit-title">Hydration</div>
                    <div class="benefit-text">
                        Drink plenty of water. Avoid caffeine and alcohol before donation.
                    </div>
                </div>

                <div class="benefit-item">
                    <div class="benefit-icon">⏰</div>
                    <div class="benefit-title">Frequency</div>
                    <div class="benefit-text">
                        Wait at least 56 days between donations (8 weeks minimum).
                    </div>
                </div>
            </div>
        </div>

        <!-- Hospital Locations -->
        <div class="locations" id="locations">
            <h2>🏥 Our Blood Bank Locations</h2>

            <div class="location-item">
                <div class="location-hospital">🏥 Bharatpur Hospital  </div>
                <div class="location-address">📍 City Center, Bharatpur10  - 44600</div>
                <div class="location-phone">📞 +977 981116211143 </div>
            </div>

            <div class="location-item">
                <div class="location-hospital">🏥 Aroma blood bank </div>
                <div class="location-address">📍 Rampur, Bharatpur, Rajasthan - 321203</div>
                <div class="location-phone">📞 +977 9209447344 </div>
            </div>

            <div class="location-item">
                <div class="location-hospital">🏥 chitwan medical collage</div>
                <div class="location-address">📍 Civil Lines, Bharatpur, Rajasthan - 321001</div>
                <div class="location-phone">📞 +977 925363652</div>
            </div>

            <div class="location-item">
                <div class="location-hospital">🏥 Provience RedCross </div>
                <div class="location-address">📍 Bharatpur,/div>
                <div class="location-phone">📞 +977-5644-456-789 </div>
            </div>

            <div class="location-item">
                <div class="location-hospital">🏥 The needed person</div>
                            <div class="location-address">📍contact with niraj owner</div>
                <div class="location-phone"></div>| Emergency: +97013490640</div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <h3>🩸 Save Lives - Donate Blood</h3>
            <p>Your generosity can save up to 3 lives with every donation</p>
            <p>One unit of blood can help one person. Be someone's hero today!</p>
            <div class="footer-links">
                <a href="#donate">Register to Donate</a>
                <a href="#blood-inventory">Check Blood Stock</a>
                <body>
                    <div>we have some food item to this person</div>
                </body>
                <a href="#locations">Find Nearest Center</a>
                <a href="#eligibility">Eligibility Criteria</a>
            </div>
            <p style="margin-top: 20px; border-top: 1px solid rgba(255,255,255,0.2); padding-top: 15px;">
                &copy; 2026 Bharatpur Hospital Blood Bank | Saving Lives Since 2011
            </p>
        </div>
    </div>

    <script>
        function scrollToSection(sectionId) {
            const element = document.getElementById(sectionId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function submitDonation(event) {
            event.preventDefault();
            
            const name = document.getElementById('name').value;
            const bloodType = document.getElementById('blood-type').value;
            const date = document.getElementById('date').value;
            const time = document.getElementById('time').value;
            
            alert(`✅ Thank You ${name}!\n\nYour blood donation registration is confirmed:\n\nBlood Type: ${bloodType}\nDate: ${date}\nTime: ${time}\n\nPlease arrive 15 minutes early.\nWe will contact you shortly for confirmation.\n\nThank you for saving lives! ❤️`);
            
            // Reset form
            document.querySelector('.donation-form form').reset();
        }
    </script>
</body>
</html>
